<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="OrcaAI.Pages.ClientsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:OrcaAI.Models"
    xmlns:vm="clr-namespace:OrcaAI.ViewModels"
    x:DataType="vm:ClientsViewModel"
    Title="Clientes">

    <Grid Padding="24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16" MaximumWidthRequest="1000" HorizontalOptions="Fill">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout>
                <Label Text="Clientes" Style="{StaticResource PageTitle}" />
                <Label Text="Sua base de clientes fica armazenada no dispositivo." Style="{StaticResource Muted}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="+ Novo" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" VerticalOptions="Center" />
        </Grid>

        <SearchBar Grid.Row="1" Placeholder="Buscar por nome, telefone ou e-mail" Text="{Binding Search}" BackgroundColor="White" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                    <Label Text="Nenhum cliente ainda" HorizontalTextAlignment="Center" FontSize="18" FontAttributes="Bold" />
                    <Label Text="Cadastre o primeiro cliente para acelerar seus próximos orçamentos." HorizontalTextAlignment="Center" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Client">
                    <Border BackgroundColor="White" Stroke="{StaticResource Border}" Padding="16" Margin="0,0,0,10">
                        <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="10">
                            <Border Grid.RowSpan="2" WidthRequest="46" HeightRequest="46" BackgroundColor="{StaticResource PrimarySoft}" StrokeThickness="0" VerticalOptions="Start">
                                <Border.StrokeShape><RoundRectangle CornerRadius="23" /></Border.StrokeShape>
                                <Label Text="{Binding Initials}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="{StaticResource PrimaryDark}" FontAttributes="Bold" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding Phone}" Style="{StaticResource Muted}" />
                                <Label Text="{Binding Email}" Style="{StaticResource Muted}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                                <Button Text="Editar" CommandParameter="{Binding .}" Clicked="OnEditClicked" Style="{StaticResource SecondaryButton}" Padding="12,8" MinimumHeightRequest="40" />
                                <Button Text="Excluir" CommandParameter="{Binding .}" Clicked="OnDeleteClicked" BackgroundColor="#FFF0F0" TextColor="{StaticResource Danger}" CornerRadius="12" Padding="12,8" MinimumHeightRequest="40" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="3" IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
    </Grid>
</ContentPage>
