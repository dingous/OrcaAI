<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="OrcaAI.Pages.ClientsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:OrcaAI.Models"
    xmlns:vm="clr-namespace:OrcaAI.ViewModels"
    x:DataType="vm:ClientsViewModel"
    Title="Clientes"
    SafeAreaEdges="All">

    <Grid Padding="24" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="16" MaximumWidthRequest="1000" HorizontalOptions="Fill">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="3">
                <Label Text="Clientes" Style="{StaticResource PageTitle}" />
                <Label Text="Sua base de clientes fica armazenada no dispositivo." Style="{StaticResource Muted}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="+ Novo" Command="{Binding AddCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource PrimaryButton}" VerticalOptions="Center" Padding="16,11" />
        </Grid>

        <SearchBar Grid.Row="1" Placeholder="Buscar por nome, telefone ou e-mail" Text="{Binding Search}" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <VerticalStackLayout Padding="10" Spacing="8">
                        <Label Text="{Binding EmptyTitle}" HorizontalTextAlignment="Center" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="{Binding EmptyMessage}" HorizontalTextAlignment="Center" Style="{StaticResource Muted}" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Client">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="10">
                            <Border Grid.RowSpan="2" WidthRequest="46" HeightRequest="46" BackgroundColor="{StaticResource PrimarySoft}" StrokeThickness="0" VerticalOptions="Start">
                                <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                                <Label Text="{Binding Initials}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="{StaticResource PrimaryDark}" FontAttributes="Bold" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextPrimary}" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Phone}" IsVisible="{Binding HasPhone}" Style="{StaticResource Muted}" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Email}" IsVisible="{Binding HasEmail}" Style="{StaticResource Muted}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="6">
                                <Button Text="Editar" CommandParameter="{Binding .}" Clicked="OnEditClicked" Style="{StaticResource SecondaryButton}" Padding="12,8" MinimumHeightRequest="40" />
                                <Button Grid.Column="1" Text="Excluir" CommandParameter="{Binding .}" Clicked="OnDeleteClicked" Style="{StaticResource DangerButton}" Padding="12,8" MinimumHeightRequest="40" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="3" IsVisible="{Binding HasError}" BackgroundColor="{StaticResource DangerSoft}" StrokeThickness="0" Padding="12">
            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
        </Border>
        <ActivityIndicator Grid.Row="4" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>
