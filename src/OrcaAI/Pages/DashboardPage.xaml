<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="OrcaAI.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:OrcaAI.ViewModels"
    x:DataType="vm:DashboardViewModel"
    Title="Início">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="22" MaximumWidthRequest="1000" HorizontalOptions="Fill">
            <VerticalStackLayout Spacing="3">
                <Label Text="OrçaAI" Style="{StaticResource PageTitle}" />
                <Label Text="Orçamentos profissionais em poucos passos." Style="{StaticResource Muted}" />
            </VerticalStackLayout>

            <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0" Padding="22">
                <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                <Grid ColumnDefinitions="*,64" ColumnSpacing="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Crie um orçamento agora" TextColor="White" FontSize="23" FontAttributes="Bold" />
                        <Label Text="Descreva o serviço, ajuste os valores e compartilhe o PDF com o cliente." TextColor="#EFEDFF" FontSize="14" />
                        <Button Text="+ Novo orçamento" Command="{Binding NewQuoteCommand}" BackgroundColor="White" TextColor="{StaticResource PrimaryDark}" FontAttributes="Bold" CornerRadius="14" Margin="0,8,0,0" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                    <Image Grid.Column="1" Source="spark.svg" WidthRequest="60" HeightRequest="60" Opacity="0.95" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Label Text="Seu negócio" Style="{StaticResource SectionTitle}" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4"><Label Text="Clientes" Style="{StaticResource Muted}" /><Label Text="{Binding Clients}" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" /></VerticalStackLayout>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4"><Label Text="Orçamentos no mês" Style="{StaticResource Muted}" /><Label Text="{Binding QuotesThisMonth}" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" /></VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4"><Label Text="Pendentes" Style="{StaticResource Muted}" /><Label Text="{Binding Pending}" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource Warning}" /></VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4"><Label Text="Aprovado" Style="{StaticResource Muted}" /><Label Text="{Binding ApprovedValue}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Accent}" LineBreakMode="TailTruncation" /></VerticalStackLayout>
                </Border>
            </Grid>

            <VerticalStackLayout Spacing="10">
                <Button Text="+ Adicionar cliente" Style="{StaticResource SecondaryButton}" Command="{Binding AddClientCommand}" />
                <Button Text="Ver orçamentos" Style="{StaticResource SecondaryButton}" Command="{Binding ViewQuotesCommand}" />
            </VerticalStackLayout>

            <Border IsVisible="{Binding HasError}" BackgroundColor="{StaticResource DangerSoft}" StrokeThickness="0" Padding="12">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
            </Border>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
