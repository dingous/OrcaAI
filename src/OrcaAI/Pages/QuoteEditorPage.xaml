<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="OrcaAI.Pages.QuoteEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:OrcaAI.Models"
    xmlns:vm="clr-namespace:OrcaAI.ViewModels"
    x:DataType="vm:QuoteEditorViewModel"
    Title="Orçamento"
    SafeAreaEdges="All">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18" MaximumWidthRequest="900" HorizontalOptions="Fill">
            <VerticalStackLayout Spacing="8">
                <Label Text="Orçamento" Style="{StaticResource PageTitle}" />
                <Label Text="{Binding Number}" TextColor="{StaticResource PrimaryDark}" FontAttributes="Bold" />
                <Label Text="Status" Style="{StaticResource FieldLabel}" Margin="0,4,0,0" />
                <Picker Title="Status do orçamento" ItemsSource="{Binding StatusOptions}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedStatus}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="1. Descreva o serviço" Style="{StaticResource SectionTitle}" />
                    <Editor Text="{Binding Description}" MaxLength="4000" Placeholder="Ex.: Trocar 3 tomadas, instalar 2 luminárias e revisar o disjuntor do quarto." Style="{StaticResource EditorInput}" />
                    <Button Text="✨ Gerar rascunho inteligente" Command="{Binding GenerateDraftCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource SecondaryButton}" />
                    <Label Text="O modo local organiza a descrição sem enviar seus dados para serviços externos." Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="2. Dados do orçamento" Style="{StaticResource SectionTitle}" />
                    <Label Text="Cliente" Style="{StaticResource FieldLabel}" />
                    <Picker Title="Selecione um cliente (opcional)" ItemsSource="{Binding Clients}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedClient}" />
                    <Label Text="Título" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Title}" MaxLength="180" Placeholder="Ex.: Serviço elétrico" Style="{StaticResource Input}" />
                    <Label Text="Validade" Style="{StaticResource FieldLabel}" />
                    <DatePicker Date="{Binding ValidUntil}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="3. Itens e valores" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="+ Item" Command="{Binding AddItemCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource SecondaryButton}" Padding="14,10" MinimumHeightRequest="44" />
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:QuoteItem">
                                <Border BackgroundColor="{StaticResource SurfaceMuted}" Stroke="{StaticResource Border}" Padding="10">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                        <Entry Grid.Row="0" Grid.Column="0" Text="{Binding Description}" MaxLength="300" Placeholder="Descrição" Style="{StaticResource Input}" />
                                        <Button Grid.Row="0" Grid.Column="1"
                                                Text="×"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnRemoveItemClicked"
                                                Style="{StaticResource DangerButton}"
                                                WidthRequest="46"
                                                HeightRequest="46"
                                                Padding="0"
                                                VerticalOptions="Center" SemanticProperties.Description="Remover item do orçamento" />
                                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="Quantidade" Style="{StaticResource FieldLabel}" />
                                                <Entry Text="{Binding Quantity}" Keyboard="Numeric" Placeholder="Qtd" Style="{StaticResource Input}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                                <Label Text="Valor unitário" Style="{StaticResource FieldLabel}" />
                                                <Entry Text="{Binding UnitPrice}" Keyboard="Numeric" Placeholder="R$ 0,00" Style="{StaticResource Input}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" Margin="0,4" />

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                        <Label Text="Subtotal" Grid.Row="0" Grid.Column="0" Style="{StaticResource Muted}" VerticalOptions="Center" />
                        <Label Text="{Binding SubtotalText}" Grid.Row="0" Grid.Column="1" FontAttributes="Bold" />
                        <Label Text="Desconto" Grid.Row="1" Grid.Column="0" Style="{StaticResource Muted}" VerticalOptions="Center" />
                        <Entry Text="{Binding Discount}" Grid.Row="1" Grid.Column="1" Keyboard="Numeric" WidthRequest="130" Style="{StaticResource Input}" />
                        <Label Text="TOTAL" Grid.Row="2" Grid.Column="0" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Text="{Binding TotalText}" Grid.Row="2" Grid.Column="1" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Observações" Style="{StaticResource SectionTitle}" />
                    <Editor Text="{Binding Notes}" MaxLength="2000" Placeholder="Condições de pagamento, prazo de execução, garantia..." Style="{StaticResource EditorInput}" />
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding HasError}" BackgroundColor="{StaticResource DangerSoft}" StrokeThickness="0" Padding="12">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
            </Border>

            <VerticalStackLayout Spacing="10">
                <Button Text="Gerar PDF e compartilhar" Command="{Binding ShareCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource PrimaryButton}" />
                <Button Text="Salvar orçamento" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource SecondaryButton}" />
            </VerticalStackLayout>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
